<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BeTranslator | About</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header') %>

    <section id="about" class="stats-section">
        <div class="container">
            <div class="section-title">
                <h1>Welcome to BeTranslator</h1>
                <h2>We connect businesses and individuals with native-speaking translators who deliver accurate, reliable and culturally appropriate translations across legal, medical, technical and marketing fields.</h2>
            </div>
            <p style="margin-top:16px; color:#24435a;">Founded by professional linguists, BeTranslator combines experienced translators, subject-matter reviewers and a dedicated project management team to ensure fast turnaround, confidentiality and consistent quality for all projects.</p>

            <div class="stats-flex-container">
                <div class="stats-grid">
                    <div class="stat-item">
                        <h3>123,000+</h3>
                        <p>Translated Pages</p>
                    </div>
                    <div class="stat-item">
                        <h3>2,400+</h3>
                        <p>Happy Clients</p>
                    </div>
                    <div class="stat-item">
                        <h3>40+</h3>
                        <p>Professional Translators</p>
                    </div>
                    <div class="stat-item">
                        <h3>15+</h3>
                        <p>Years of Experience</p>
                    </div>
                </div>

                <div class="stats-picture-holder">
                    <img src="/images/home_translator_video.jpg" alt="Team meeting">
                </div>

            </div>
        </div>
    </section>

    <%- include('partials/footer') %>
</body>
</html>
