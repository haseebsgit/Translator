<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BeTranslator | Home</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/header') %>

    <section class="hero-section">
        <div class="container hero-content">
            <div class="hero-words">
                <h1>Bridging the World Through Language</h1>
                <p>We provide certified professional translation services for businesses, legal documents, and academic needs. Fast, accurate, and reliable.</p>
                <a href="/services" class="button-style">View Our Services</a>
            </div>
            <div class="hero-image">
               </div>
        </div>
    </section>

    <section class="stats-section">
        <div class="container">
            <div class="section-title">
                <h2>Our Achievements</h2>
                <h1>Trusted by Global Companies</h1>
            </div>

            <div class="stats-flex-container">
                <div class="stats-grid">
                    <div class="stat-item">
                        <h3>10k+</h3>
                        <p>Projects Done</p>
                    </div>
                    <div class="stat-item">
                        <h3>50+</h3>
                        <p>Languages</p>
                    </div>
                    <div class="stat-item">
                        <h3>500+</h3>
                        <p>Expert Translators</p>
                    </div>
                    <div class="stat-item">
                        <h3>99%</h3>
                        <p>Client Satisfaction</p>
                    </div>
                </div>

                <div class="stats-picture-holder">
                    <img src="/images/office-meeting.jpg" alt="Stats Image" onerror="this.style.display='none'"> 
                </div>
            </div>
        </div>
    </section>

    <section class="promo-banner">
        <div class="promo-text-side">
            <h1>Ready to Expand Your Business Globally?</h1>
            <p style="margin-bottom: 20px;">Get a free quote today and start communicating with the world.</p>
            <a href="/contact" class="promo-button">Contact Us</a>
        </div>
        
        <div class="promo-grid-side">
            <div class="promo-grid-item">
                <h2>24/7</h2>
                <p>Customer Support available round the clock.</p>
            </div>
            <div class="promo-grid-item">
                <h2>Fast</h2>
                <p>Quick turnaround times for urgent documents.</p>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>

</body>
</html>