<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BeTranslator | Services</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header') %>

    <section id="services" class="services-section">
        <div class="container">
            <h2>Our Services</h2>
            <div class="services-box-container">
                <div class="service-box">
                    <img src="/images/message.png" alt="">
                    <h3>Document Translation</h3>
                    <p>Accurate and fast translations of all kinds of documents by native speakers.</p>
                </div>
                <div class="service-box">
                    <img src="/images/icon.png" alt="">
                    <h3>Certified Translation</h3>
                    <p>Legally recognized certified translations accepted by government agencies.</p>
                </div>
                <div class="service-box">
                    <img src="/images/calendar.png" alt="">
                    <h3>Website Translation</h3>
                    <p>Make your website accessible in multiple languages for a global audience.</p>
                </div>
                <div class="service-box">
                    <img src="/images/text interpreting.png" alt="">
                    <h3>Text Interpreting</h3>
                    <p>Professional interpreters available for live meetings, events, and conferences.</p>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>
</body>
</html>
